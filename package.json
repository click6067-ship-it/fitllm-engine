{
  "name": "fitllm-engine",
  "version": "2.14.1",
  "description": "Auditable local-LLM memory estimates for GPUs and Macs. Models sliding-window, hybrid/linear, MLA compressed-KV and MoE architectures. Zero deps, single file, conformance-vector tested.",
  "type": "module",
  "main": "engine.js",
  "exports": {
    ".": "./engine.js"
  },
  "bin": {
    "fitllm": "bin/fitllm.mjs"
  },
  "files": [
    "engine.js",
    "bin",
    "vectors"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs && node vectors/run.mjs",
    "census": "node census/generate.mjs",
    "alias:dry-run": "node scripts/publish-alias.mjs --dry-run",
    "day0:dry-run": "node .github/scripts/day0-watch.mjs --dry-run",
    "census:check": "node census/check.mjs",
    "benchmark:accuracy": "node scripts/accuracy-report.mjs",
    "benchmark:capture:llmfit": "node scripts/capture-llmfit.mjs",
    "benchmark:differential": "node scripts/differential-report.mjs"
  },
  "keywords": [
    "llm",
    "vram",
    "memory-calculator",
    "kv-cache",
    "will-it-run",
    "apple-silicon",
    "nvidia",
    "amd",
    "mla",
    "moe",
    "quantization",
    "gguf",
    "llama-cpp",
    "mlx",
    "ollama"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/click6067-ship-it/fitllm-engine.git"
  },
  "homepage": "https://fitllm.run"
}
